+++ b/bsd/dev/negroni_ufs_preserve.h
@@ -0,0 +1,32 @@
+/* Internal-UFS commands allowed while Android is preserved. No runtime override. */
+#ifndef NEGRONI_UFS_PRESERVE_H
+#define NEGRONI_UFS_PRESERVE_H
+#define NEGRONI_PRESERVE_ANDROID 1
+
+static inline int
+negroni_ufs_preserve_allows(const unsigned char *cdb, unsigned cdb_len,
+    unsigned len, int write)
+{
+    if (!cdb || write || cdb_len == 0 || len > (1u << 20)) {
+        return 0;
+    }
+    switch (cdb[0]) {
+    case 0x00: /* TEST UNIT READY, no medium mutation */
+        return cdb_len == 6 && len == 0 && cdb[1] == 0 && cdb[2] == 0 &&
+            cdb[3] == 0 && cdb[4] == 0 && cdb[5] == 0;
+    case 0x1b: /* Existing UFS Device W-LUN power-active request only */
+        return cdb_len == 6 && len == 0 && cdb[1] == 0 && cdb[2] == 0 &&
+            cdb[3] == 0 && cdb[4] == 0x10 && cdb[5] == 0;
+    case 0x28: { /* READ(10), using this driver's 4096-byte device blocks */
+        unsigned blocks;
+        if (cdb_len != 10 || cdb[1] != 0 || cdb[6] != 0 || cdb[9] != 0) {
+            return 0;
+        }
+        blocks = ((unsigned)cdb[7] << 8) | cdb[8];
+        return blocks != 0 && len == blocks * 4096u;
+    }
+    default: /* Includes WRITE, UNMAP, FORMAT, MODE SELECT and cache flush. */
+        return 0;
+    }
+}
+#endif
